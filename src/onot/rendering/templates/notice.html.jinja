<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>OSS Notice for {{ doc.name }}</title>
<style>
body { font-family: -apple-system, Helvetica, Arial, sans-serif; margin: 2rem auto; max-width: 60rem; color: #1a1a1a; }
h1 { font-size: 1.6rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
th, td { border: 1px solid #ddd; padding: .4rem .6rem; text-align: left; font-size: .9rem; }
th { background: #f5f5f5; }
.license { margin: 1.5rem 0; }
.license h3 { margin-bottom: .25rem; }
.license .used-by { color: #666; font-size: .85rem; }
pre { background: #f7f7f7; padding: .75rem; overflow-x: auto; white-space: pre-wrap; font-size: .8rem; }
</style>
</head>
<body>
<h1>OSS Notice for {{ doc.name }}</h1>
{% if generated %}
<p>Generated: {{ generated }}</p>
{% endif %}

<h2>Components</h2>
<table>
<thead><tr><th>Name</th><th>Version</th><th>License</th><th>Copyright</th></tr></thead>
<tbody>
{% for pkg in doc.packages %}
<tr>
<td>{{ pkg.name }}</td>
<td>{{ pkg.version }}</td>
<td>{{ pkg.effective_expression or "" }}</td>
<td>{{ pkg.copyright or "" }}</td>
</tr>
{% endfor %}
</tbody>
</table>

<h2>Licenses</h2>
{% for lic in doc.licenses %}
<div class="license">
<h3>{{ lic.name }}</h3>
<p class="used-by">Used by: {{ lic.used_by | join(", ") }}</p>
{% if lic.text %}
<pre>{{ lic.text }}</pre>
{% endif %}
</div>
{% endfor %}
</body>
</html>
